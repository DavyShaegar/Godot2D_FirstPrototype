; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Skeleton Forest"
config/description="A simple game in which you need to survive an endless onslaught of enemies. You can't win, just get the most score!"
config/tags=PackedStringArray("arcade", "mygames")
run/main_scene="res://Scenes/menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]

GlobalHandler="*res://Globals/global_handler.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="uid://dc433a8kg2auu"

